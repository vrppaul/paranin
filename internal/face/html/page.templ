package html

import (
	"strconv"
	"strings"
	"time"

	"github.com/vrppaul/paranin/internal/assets"
	"github.com/vrppaul/paranin/internal/compose"
	"github.com/vrppaul/paranin/internal/document"
	"github.com/vrppaul/paranin/internal/look"
	"github.com/vrppaul/paranin/internal/routes"
)

// page is a page of a document in its language: what it says of itself, its title, its description, the address it is
// known by with Open Graph and its record as linked data, and its markdown, each where it has one; then its main part
// and the foot line.
templ (writer PageWriter) page(language string, metadata pageMetadata, record compose.Record, main templ.Component, foot footLine) {
	<!DOCTYPE html>
	<html lang={ language }>
		<head>
			@headOpening(metadata.title, writer.included)
			if metadata.description != "" {
				<meta name="description" content={ metadata.description }/>
			}
			if metadata.canonical != "" {
				<link rel="canonical" href={ metadata.canonical }/>
				@writer.openGraph(metadata)
				@writer.linkedData(record, metadata.canonical)
			}
			if metadata.markdown != "" {
				<link rel="alternate" type={ markdownType } href={ metadata.markdown }/>
			}
		</head>
		<body>
			<main class="content-width">
				@main
			</main>
			@footLineMarkup(foot)
		</body>
	</html>
}

// headOpening is what the head of every page opens with: its text's encoding, its width a phone's own, its title,
// the pictures of the site a browser shows beside it, and what it includes to run the site's script, in the order
// Vite's guide lays it: the stylesheets it is drawn in, the script, then the scripts it imports, to preload. The
// script holds the first paint until it has run, so a theme the reader chose is the one the page is first seen in;
// a browser that knows no such hold shows the page first in the system's theme.
templ headOpening(title string, included assets.Included) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<title>{ title }</title>
	@iconLinks()
	for _, stylesheet := range included.Stylesheets {
		<link rel="stylesheet" href={ stylesheet }/>
	}
	<script type="module" src={ included.Script } blocking="render"></script>
	for _, preload := range included.Preloads {
		<link rel="modulepreload" href={ preload }/>
	}
}

// footLineMarkup is the line at the foot of every page (DESIGN.md, FootLine), after its main part, as tmux's status
// line: the sessions, the site's name leading to where it begins; the document's tabs as windows, each by its number
// and name leading to its page, the one shown the current page; the ways the site is served as chips, the programs
// that reach it and read it in a terminal, each opening its hint, and the page's markdown; then the switch that turns
// the vim keys on, and the theme button. Over it stands the command line the vim keys open, and the toast that says
// what a command's chip on the page, or in a hint, copied.
templ footLineMarkup(foot footLine) {
	<div class="foot" data-part={ footPart }>
		@commandLineMarkup(foot)
		<nav class="foot-row content-width">
			<span class="sessions">
				for _, shown := range foot.sessions {
					@sessionMark(shown)
				}
			</span>
			if len(foot.windows) > 0 {
				<ul class="windows">
					for _, window := range foot.windows {
						<li>
							@windowLink(window)
						</li>
					}
				</ul>
			}
			<div class="ways">
				for _, offered := range foot.hints {
					@wayWithHint(offered)
				}
				<a class="way-chip" href={ foot.markdown }>{ foot.markdownName }</a>
			</div>
			@vimKeysSwitch()
			@themeButton(foot.frame.darkTheme)
		</nav>
		@toast()
	</div>
}

// sessionMark is a session as tmux writes one, its name between brackets a screen reader skips, leading to where it
// begins; the one the page belongs to marked, which the stylesheet colours.
templ sessionMark(shown session) {
	<a class={ "session", templ.KV("session-other", !shown.current) } href={ shown.address }>
		<span aria-hidden="true">{ sessionOpening }</span>{ shown.name }<span aria-hidden="true">{ sessionClosing }</span>
	</a>
}

// vimKeysSwitch is the switch that turns the vim keys on (DESIGN.md, VimKeys), a checkbox as a terminal writes one,
// its box drawn in brackets, the stylesheet ticking it, and the whole label its target. The site's script shows it and
// keeps the reader's choice; a page read without the script has no keys to turn on, and hides it.
templ vimKeysSwitch() {
	<label class="vim-keys" data-part={ vimKeysPart } hidden><input type="checkbox" class="vim-keys-box"/><span class="vim-keys-mark" aria-hidden="true">[<span class="vim-keys-tick"></span>]</span>{ vimKeysWords }</label>
}

// commandLineMarkup is the command line the vim keys open over the foot line (DESIGN.md, CommandLine), as Neovim's
// stands with no row of its own: a field the reader types a place's name or a command in, after the colon, or a
// search after the slash, the menu of the places that fit what is typed over it, what the line says of a command or a
// search, and the keys that finish it, a search's with the count of its matches; the field names the blog's folder,
// where :e opens a post the menu does not list. The site's script opens it, shows the mark and the keys of the key
// that opened it, and goes where it says or marks what it finds.
templ commandLineMarkup(foot footLine) {
	<div class="command-line content-width" data-part={ commandLinePart } hidden>
		<div class="command-entry" data-part={ commandEntryPart }>
			<ul id={ ownID(placesPart) } class="places-menu" role="listbox" aria-label={ placesName } data-part={ placesPart } hidden>
				for index, shown := range foot.places {
					@placeItem(index, shown)
				}
			</ul>
			<span class="command-mark" aria-hidden="true" data-part={ commandMarkPart }>{ commandMark }</span><span class="command-mark" aria-hidden="true" data-part={ searchMarkPart } hidden>{ searchMark }</span><input id={ ownID(commandFieldPart) } class="command-field" type="text" role="combobox" aria-label={ commandName } aria-controls={ ownID(placesPart) } aria-expanded="false" aria-autocomplete="list" aria-describedby={ ownID(commandKeysPart) } autocomplete="off" autocapitalize="off" spellcheck="false" data-part={ commandFieldPart } data-search-name={ searchName } data-folder={ foot.frame.folder } data-folder-address={ foot.frame.folderAddress }/>
		</div>
		<p class="command-said" role="alert" data-part={ commandSaidPart } hidden></p>
		<span id={ ownID(commandKeysPart) } class="command-keys" data-part={ commandKeysPart }>
			@keyHint(tabKey, nextHint, nextKeyPart)
			@keyHint(enterMark, goHint, "")
			@keyHint(escapeKey, cancelHint, "")
		</span>
		<span id={ ownID(searchKeysPart) } class="command-keys" data-part={ searchKeysPart } hidden>
			<span class="command-count" data-part={ searchCountPart }></span>
			@keyHint(enterMark, findHint, "")
			@keyHint(escapeKey, cancelHint, "")
		</span>
	</div>
}

// keyHint is a key the command line names and what it does, the key a cap; a part names it where the site's script
// shows and hides it.
templ keyHint(key, does, part string) {
	<span
		class="command-hint"
		if part != "" {
			data-part={ part }
		}
	><kbd class="command-key">{ key }</kbd> { does }</span>
}

// placeItem is a place on the command line's menu, hidden until what is typed fits it: its name, the letters typed of
// it apart from the rest, and what it is; it carries what the site's script reads of it, its name and the address it
// leads to, its kind, whether it is the page shown, and whether :e opens it.
templ placeItem(index int, shown place) {
	<li id={ placeID(index) } class="places-item" role="option" aria-selected="false" data-part={ placePart } data-place={ string(shown.kind) } data-name={ shown.name } data-address={ shown.address } data-current?={ shown.current } data-edit?={ shown.edited } hidden><span class="places-name"><span class="places-typed" data-part={ placeTypedPart }></span><span data-part={ placeRestPart }>{ shown.name }</span></span> <span class="places-kind">{ string(shown.kind) }</span></li>
}

// windowLink is a tab as tmux writes a window, its number, a colon and its name, leading to its page; the current one
// the page shown, which the stylesheet marks.
templ windowLink(window window) {
	<a
		class="window"
		href={ window.address }
		if window.current {
			aria-current="page"
		}
	><span class="window-number">{ window.number + windowColon }</span>{ window.name }</a>
}

// wayWithHint is a way the site is served, as a chip by the program it runs, and the hint it opens (DESIGN.md, Hint):
// a popover, so it works with no script, its close button last, so the keyboard reaches the copy first.
templ wayWithHint(offered hint) {
	<button type="button" class="way-chip" popovertarget={ offered.id }><span class="way-mark" aria-hidden="true">{ look.PromptMark }</span>{ offered.way.Program }</button>
	<div id={ offered.id } class="hint" popover role="dialog" aria-labelledby={ offered.titleID } data-part={ hintPart }>
		<p id={ offered.titleID } class="hint-title">{ offered.way.Program }</p>
		@command(offered.way.Command)
		<p class="hint-gives">{ offered.way.Gives }</p>
		<button type="button" class="hint-close" popovertarget={ offered.id } popovertargetaction="hide"><kbd class="command-key" aria-hidden="true">{ escapeKey }</kbd> { closeHint }</button>
	</div>
}

// themeButton is the reader's theme: one button that turns the page to the theme it is not in, pressed while the
// page is dark, named by the words beside it, which show as its tooltip under the pointer and on focus. The site's
// script shows it and runs it; a page read without the script hides it, and follows the system's theme.
templ themeButton(name string) {
	<span class="theme" data-part={ themePart } hidden>
		<button type="button" class="theme-button" aria-pressed="false" aria-labelledby={ ownID(themeNameID) }>
			@themeMark()
		</button>
		<span id={ ownID(themeNameID) } class="tooltip" data-part={ tooltipPart }>{ name }</span>
	</span>
}

// themeMark is the theme button's mark, drawn as the design draws its marks (DESIGN.md, Iconography): in a box of
// sixteen units, in the colour of its words, a ring with its right half filled. It is the same in either theme, so it
// never has to say which way a press goes.
templ themeMark() {
	<svg class="mark" viewBox={ markViewBox } aria-hidden="true">
		<circle class="mark-line" cx="8" cy="8" r="6.5" stroke-width="1.5"></circle>
		<path class="mark-fill" d="M8 1.5a6.5 6.5 0 0 1 0 13z"></path>
	</svg>
}

// openGraph is how a page reads where a link to it is shared (ogp.me): the site it is of, its title and
// description, and the address it is known by. Its picture comes with the cards Typst draws (ADR-0005).
templ (writer PageWriter) openGraph(metadata pageMetadata) {
	<meta property="og:type" content={ openGraphType }/>
	<meta property="og:site_name" content={ writer.site.Host() }/>
	<meta property="og:title" content={ metadata.title }/>
	if metadata.description != "" {
		<meta property="og:description" content={ metadata.description }/>
	}
	<meta property="og:url" content={ metadata.canonical }/>
}

// plainMain is the main part of a page under its head: the head, then blocks, a row apart as a résumé section's are.
templ (writer PageWriter) plainMain(head document.Head, blocks []document.Block) {
	@writer.head(head)
	@writer.pageBlocks(blocks)
}

// tabMain is the main part of a tab of a page that is not the résumé: its title, then its blocks, as a page's head and
// blocks stand.
templ (writer PageWriter) tabMain(title templ.Component, blocks []document.Block) {
	<div class="page-head">
		@title
	</div>
	@writer.pageBlocks(blocks)
}

// pageBlocks are the blocks after a page's head, a row apart as a résumé section's are.
templ (writer PageWriter) pageBlocks(blocks []document.Block) {
	<div class="blocks page-blocks">
		for _, block := range blocks {
			@writer.block(block, firstHeadingDepth)
		}
	</div>
}

// resumeMain is the résumé's opening: its first screen, then the blocks that are no section, then its first section.
templ (writer PageWriter) resumeMain(head document.Head, parts resumeParts) {
	@writer.firstScreen(head, parts)
	for _, block := range parts.others {
		@writer.block(block, firstHeadingDepth)
	}
	@writer.openingSection(parts.first)
}

// firstScreen is the résumé's first screen (DESIGN.md, Pages): the greeting, the author's name in block letters and
// the lead in one column; beside it the brief, its parts a row apart: the address heading it, the subtitle and the
// place; the facts; and what the brief offers to do, side by side: the primary button that writes to the author,
// which opens the form once there is one (TODO, Hosting) and does nothing until then, and the command that reaches the
// site over ssh, to copy.
templ (writer PageWriter) firstScreen(head document.Head, parts resumeParts) {
	<div class="first-screen">
		<div class="introduction">
			@writer.introduction(head, parts)
		</div>
		if len(parts.career.roles) > 0 {
			@careerLine(parts.career)
		}
		@corners()
	</div>
}

// corners are the crosses that mark the first screen's four corners (DESIGN.md, Frame and Section), as the TUI marks
// its page's: a look a screen reader skips.
templ corners() {
	@crossMark("cross cross-top cross-left")
	@crossMark("cross cross-top cross-right")
	@crossMark("cross cross-bottom cross-left")
	@crossMark("cross cross-bottom cross-right")
}

// crossMark is a corner's cross, drawn as the design draws its marks (DESIGN.md, Iconography): in a box of sixteen
// units, two hairlines across it, in the colour of its words.
templ crossMark(class string) {
	<svg class={ class } viewBox={ markViewBox } aria-hidden="true">
		<path class="mark-line" d="M8 0V16M0 8H16"></path>
	</svg>
}

// introduction is the first screen's top: the name's column and the brief beside it.
templ (writer PageWriter) introduction(head document.Head, parts resumeParts) {
	<div class="name-column">
		if head.Greeting != "" {
			<p class="greeting">{ head.Greeting }</p>
		}
		@writer.drawnTitle(head)
		if len(head.Lead) > 0 {
			<p class="lead">
				@writer.spans(head.Lead)
			</p>
		}
	</div>
	<div class="brief">
		<div>
			@writer.mail(parts.address)
			if len(head.Subtitle) > 0 {
				<p class="role">
					@writer.spans(head.Subtitle)
				</p>
			}
			if head.Place != "" {
				<p class="place">{ head.Place }</p>
			}
		</div>
		@writer.facts(parts.brief)
		<div class="actions">
			<button type="button" class="button-primary">{ writer.frame.writeTo }</button>
			@command(writer.frame.ssh.Command)
		</div>
		if len(parts.profiles) > 0 {
			<p class="profiles">
				@writer.linkLine(parts.profiles)
			</p>
		}
	</div>
}

// careerLine is every role of the résumé on one line of time (DESIGN.md, CareerLine), each as long as it lasted, its
// company over it on one of two rows in turn, the one still held marked; the year the line starts and the word it ends
// in under it. A phone shows the roles as a list instead: their years, the company and a bar as long as the role
// beside the longest. A screen reader skips both, at any width: they picture the roles the experience section holds
// in words.
templ careerLine(career careerDrawing) {
	<div class="career">
		<svg class="career-line" aria-hidden="true" width={ wholeLength } height={ careerLineHeight }>
			for _, role := range career.roles {
				<g
					if role.current {
						class={ currentRoleClass }
					}
				>
					<text x={ role.left } y={ role.baseline }>{ role.company }</text>
					<rect class="career-span" x={ role.left } y={ spanTop } width={ role.width } height={ spanHeight }></rect>
				</g>
			}
		</svg>
		<p class="career-ends" aria-hidden="true"><span>{ career.start }</span><span>{ career.end }</span></p>
		<ol class="career-list" aria-hidden="true">
			for _, role := range career.roles {
				<li
					if role.current {
						class={ currentRoleClass }
					}
				><span class="career-years">{ role.years }</span><span class="career-company">{ role.company }</span><svg class="career-bar" width={ wholeLength }><rect width={ role.share } height={ wholeLength }></rect></svg></li>
			}
		</ol>
	</div>
}

// command is a command the reader can run (DESIGN.md, Command): the prompt's mark, the command as code a reader may
// select, and the button that copies it, hidden until the site's script shows it and lets the whole chip copy.
templ command(command compose.Copyable) {
	<div class="command" data-part={ commandPart }>
		<span class="command-prompt" aria-hidden="true">{ look.PromptMark }</span>
		<code data-part={ commandWordsPart }>{ command.Text }</code>
		<button type="button" class="command-copy" data-part={ copyPart } aria-label={ command.Button.CopyName } data-copied={ command.Button.Copied } data-toast={ command.Button.Toast } hidden>{ command.Button.Copy }</button>
	</div>
}

// toast says what was done (DESIGN.md, Tooltip and Toast): the tick, then the words the site's script puts in, each
// word of them drawn from the template after them, over the foot line while it shows. It stands in a region a screen
// reader reads out as it changes, which holds no box of its own.
templ toast() {
	<div role="status">
		<p class="toast" data-part={ toastPart } hidden><span class="toast-mark" aria-hidden="true">{ look.DoneMark }</span><span data-part={ toastWordsPart }></span><template data-part={ toastWordPart }><span class="toast-word"></span></template></p>
	</div>
}

// mail is the address heading the brief (DESIGN.md, Mail), in the heading's size; as its words where it is no link
// to a mailbox.
templ (writer PageWriter) mail(address []document.Span) {
	if mail, isMail := document.MailOf(address); isMail {
		@mailLink(mail, true)
	} else if len(address) > 0 {
		<p>
			@writer.spans(address)
		</p>
	}
}

// mailLink is a mail address (DESIGN.md, Mail): a link that writes to it, its mailbox, its at and its host each a part
// the stylesheet colours, or the address whole where it holds no at; in the size of the heading it is, or of the text
// it stands among.
templ mailLink(mail document.Mail, heading bool) {
	<a class={ "mail", templ.KV("mail-heading", heading) } href={ routes.Reference(mail, routes.FormatChosen) }>
		if box, host, parted := mail.Parts(); parted {
			<span class="mail-box">{ box }</span><span class="mail-at">{ document.MailAt }</span><span class="mail-host">{ host }</span>
		} else {
			{ mail.Address }
		}
	</a>
}

// head is what the page's main part shows first (DESIGN.md, Contents and PageHead): its title in block letters, its
// line, the subtitle and the place beside it; what a project is made of, joined in one line, words that do nothing
// when pressed; the lead; and where a project's code lives.
templ (writer PageWriter) head(head document.Head) {
	<div class="page-head">
		@writer.drawnTitle(head)
		if len(head.Subtitle) > 0 || head.Place != "" {
			<p class="page-line">
				@writer.spans(head.Subtitle)
				if len(head.Subtitle) > 0 && head.Place != "" {
					@text(dot)
				}
				@text(head.Place)
			</p>
		}
		if len(head.Tags) > 0 {
			<p class="page-tags">{ strings.Join(head.Tags, dot) }</p>
		}
		if len(head.Lead) > 0 {
			<p class="page-lead">
				@writer.spans(head.Lead)
			</p>
		}
		if repository := head.Repository.Facts(); len(repository) > 0 {
			@writer.facts(repository)
		}
	</div>
}

templ (writer PageWriter) section(section document.Section, depth int) {
	<section>
		@heading(depth, unnamed, writer.spans(section.Title))
		for _, block := range section.Blocks {
			@writer.block(block, depth+1)
		}
	</section>
}

templ (writer PageWriter) paragraph(paragraph document.Paragraph) {
	<p>
		@writer.spans(paragraph.Spans)
	</p>
}

// table is rows of cells (DESIGN.md, Table), under the row that names its columns where it has one, as a post's may,
// in a part that scrolls sideways where the screen is narrower than the table, so the page never does. A table that
// names no columns is marked, since a phone folds it into a grid, and each of its parts names its role, which a
// browser drops from a table laid out as a grid.
templ (writer PageWriter) table(table document.Table) {
	{{ namesColumns := len(table.Header.Cells) > 0 }}
	<div class="table-scroll">
		<table
			class={ "table", templ.KV("table-headerless", !namesColumns) }
			if !namesColumns {
				role="table"
			}
		>
			if namesColumns {
				<thead>
					<tr>
						for _, cell := range table.Header.Cells {
							<th scope="col">
								@writer.spans(cell.Spans)
							</th>
						}
					</tr>
				</thead>
			}
			<tbody
				if !namesColumns {
					role="rowgroup"
				}
			>
				for _, row := range table.Rows {
					<tr
						if !namesColumns {
							role="row"
						}
					>
						for _, cell := range row.Cells {
							<td
								if !namesColumns {
									role="cell"
								}
								if setBack(cell.Kind) {
									class="table-duration"
								}
							>
								@writer.spans(cell.Spans)
							</td>
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// codeBlock is text shown as it is, line for line, scrolling sideways rather than wrapping (DESIGN.md, Code).
templ codeBlock(runs []document.CodeRun) {
	<pre class="code-block">
		@codeRuns(runs)
	</pre>
}

// codeRuns are code's runs as they are, each of a kind the stylesheet colours in a span its class names, the rest as
// text: no space stands between two, since each run is drawn through a template of its own.
templ codeRuns(runs []document.CodeRun) {
	for _, run := range runs {
		if class, coloured := codeClass(run.Kind); coloured {
			<span class={ class }>{ run.Text }</span>
		} else {
			@text(run.Text)
		}
	}
}

// facts are labels and their values, each value as factValue draws it.
templ (writer PageWriter) facts(facts []document.Fact) {
	<dl class="facts">
		for _, fact := range facts {
			<dt>{ fact.Label }</dt>
			<dd>
				@writer.factValue(fact)
			</dd>
		}
	</dl>
}

// entry is a role or a school (DESIGN.md, Entry): its period in a column of its own, marked where it still goes on;
// then its title and subtitle as its heading, its place under them, and its points, each after the point's mark.
templ (writer PageWriter) entry(entry document.Entry, depth int) {
	<article class={ "entry", templ.KV("entry-now", entry.Period.GoesOn()) }>
		<p class="entry-when">
			@month(entry.Period.Start)
			@text(rangeDash)
			@month(entry.Period.End)
		</p>
		<div class="entry-body">
			@heading(depth, unnamed, writer.titled(entry.Title, entry.Subtitle))
			if entry.Place != "" {
				<p class="entry-place">{ entry.Place }</p>
			}
			if len(entry.Points) > 0 {
				<ul class="points">
					for _, point := range entry.Points {
						<li>
							<span class="point-mark" aria-hidden="true">{ look.PointMark }</span>
							@text(pointSpace)
							@writer.spans(point.Spans)
						</li>
					}
				</ul>
			}
		</div>
	</article>
}

// card is a piece of work (DESIGN.md, Card): its title, a link to its page where it has one; its tag and subtitle in
// a line, its summary, then its facts.
templ (writer PageWriter) card(card document.Card, depth int) {
	<article class="card">
		@heading(depth, unnamed, writer.spans(linked(card.Page, card.Title)))
		if card.Tag != "" || len(card.Subtitle) > 0 {
			<p class="card-line">
				@text(card.Tag)
				if card.Tag != "" && len(card.Subtitle) > 0 {
					@text(dot)
				}
				@writer.spans(card.Subtitle)
			</p>
		}
		if len(card.Summary) > 0 {
			<p>
				@writer.spans(card.Summary)
			</p>
		}
		if len(card.Facts) > 0 {
			@writer.facts(card.Facts)
		}
	</article>
}

// contents are the pages a document leads to, each a link by its title, then the line on what it is.
templ (writer PageWriter) contents(contents document.Contents) {
	<ul>
		for _, listing := range contents.Listings {
			<li>
				@writer.spans(linked(listing.Page, listing.Title))
				if len(listing.Note) > 0 {
					@text(labelEnd)
					@writer.spans(listing.Note)
				}
			</li>
		}
	</ul>
}

// titled is a title and its subtitle in one line, a dash between them where both are there.
templ (writer PageWriter) titled(title, subtitle []document.Span) {
	@writer.spans(title)
	if len(title) > 0 && len(subtitle) > 0 {
		@text(dash)
	}
	@writer.spans(subtitle)
}

templ (writer PageWriter) spans(spans []document.Span) {
	for _, span := range spans {
		@writer.span(span)
	}
}

// text is text as it reads. Text beside the other parts of a line is written through it, never as an expression
// of its own: templ writes a space before an expression that opens a line of the template after another part.
templ text(text string) {
	{ text }
}

templ code(text string) {
	<code>{ text }</code>
}

// gap is a place the author has still to fill, among written words, written as the content writes it, in its brackets
// (DESIGN.md, Highlight).
templ gap(text string) {
	<span class="gap">{ text }</span>
}

templ (writer PageWriter) highlight(spans []document.Span) {
	<mark>
		@writer.spans(spans)
	</mark>
}

templ (writer PageWriter) link(address string, spans []document.Span) {
	<a href={ address }>
		@writer.spans(spans)
	</a>
}

// knownMonth is a month of a year as a time: as a reader reads it, and as a machine does.
templ knownMonth(start time.Time) {
	<time datetime={ start.Format(machineMonthLayout) }>{ start.Format(monthLayout) }</time>
}

// resumeSection is a section of the résumé (DESIGN.md, Frame and Section): its heading, and its blocks beside it, or
// under it where the two do not fit side by side.
templ (writer PageWriter) resumeSection(blocks []document.Block, heading templ.Component) {
	<section class="section">
		@heading
		<div class="blocks">
			for _, block := range blocks {
				@writer.block(block, firstHeadingDepth+1)
			}
		</div>
	</section>
}

// letteredHeadingTwo is a section's title in block letters, named by its words.
templ letteredHeadingTwo(title letterDrawing) {
	<h2 aria-label={ title.words }>
		@blockLetters(title)
	</h2>
}

// letteredHeadingOne is a page's title in block letters, named by its words.
templ letteredHeadingOne(title letterDrawing) {
	<h1 aria-label={ title.words }>
		@blockLetters(title)
	</h1>
}

// blockLetters is a drawing of block letters as an SVG a screen reader skips, its heading naming its words: its
// rectangles filled with one gradient from the accent to the host's colour, which the stylesheet gives its stops, and
// the cursor after them where it has one. Its width and height are in em, a cell an em, so the stylesheet sizes it
// by its font size, and it shrinks to its column.
templ blockLetters(drawing letterDrawing) {
	<svg class={ drawing.class } aria-hidden="true" viewBox={ viewBoxOf(drawing.width, drawing.height) } width={ drawing.svgWidth() } height={ drawing.svgHeight() } shape-rendering="crispEdges">
		<defs>
			<linearGradient id={ drawing.gradientID() } gradientUnits="userSpaceOnUse" x1="0" y1="0" x2={ strconv.Itoa(drawing.width) } y2="0">
				<stop class="letters-start" offset="0"></stop>
				<stop class="letters-end" offset="1"></stop>
			</linearGradient>
		</defs>
		<g fill={ "url(#" + drawing.gradientID() + ")" }>
			for _, rectangle := range drawing.rectangles {
				@letterRectangleOf(rectangle, "")
			}
		</g>
		if drawing.cursor != nil {
			@letterRectangleOf(*drawing.cursor, "letters-cursor")
		}
	</svg>
}

// letterRectangleOf is one rectangle of a drawing, of a class where it has one.
templ letterRectangleOf(rectangle letterRectangle, class string) {
	<rect
		if class != "" {
			class={ class }
		}
		x={ strconv.Itoa(rectangle.left) }
		y={ strconv.Itoa(rectangle.top) }
		width={ strconv.Itoa(rectangle.width) }
		height={ strconv.Itoa(rectangle.height) }
	></rect>
}

templ headingOne(title templ.Component) {
	<h1>
		@title
	</h1>
}

templ headingTwo(named templ.Attributes, title templ.Component) {
	<h2 { named... }>
		@title
	</h2>
}

templ headingThree(named templ.Attributes, title templ.Component) {
	<h3 { named... }>
		@title
	</h3>
}

templ headingFour(named templ.Attributes, title templ.Component) {
	<h4 { named... }>
		@title
	</h4>
}

templ headingFive(named templ.Attributes, title templ.Component) {
	<h5 { named... }>
		@title
	</h5>
}

templ headingSix(named templ.Attributes, title templ.Component) {
	<h6 { named... }>
		@title
	</h6>
}
