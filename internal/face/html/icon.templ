package html

import (
	"strconv"

	"github.com/vrppaul/paranin/internal/routes"
)

// iconDrawing is the site's icon as SVG (DESIGN.md, Favicon): its square filled edge to edge with the gradient,
// which crosses it from left to right, as a gradient does unless told otherwise.
templ iconDrawing(gradient iconGradient) {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox={ viewBoxOf(drawingSide, drawingSide) }>
		<linearGradient id={ iconGradientID }>
			<stop offset="0" stop-color={ hexColour(gradient.start) }></stop>
			<stop offset="1" stop-color={ hexColour(gradient.end) }></stop>
		</linearGradient>
		<rect width={ strconv.Itoa(drawingSide) } height={ strconv.Itoa(drawingSide) } fill={ "url(#" + iconGradientID + ")" }></rect>
	</svg>
}

// iconLinks are the head's links to each picture of the site, by how it links it, its media type and the size it
// names, if any.
templ iconLinks() {
	for _, kind := range iconKinds() {
		<link
			rel={ kind.relation }
			href={ routes.PicturePath(kind.picture) }
			type={ kind.mediaType }
			if kind.sizes != "" {
				sizes={ kind.sizes }
			}
		/>
	}
}
