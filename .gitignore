# Compiled binary
/paranin
*.exe
*.test
*.out

# SSH host keys — generated at runtime, NEVER commit
.ssh/
*.pem
*_ed25519
*_ed25519.pub
ssh_host_*_key
ssh_host_*_key.pub

# Env / secrets
.env
.env.*
!.env.example

# Go
/vendor/
/dist/

# The page's tools, which pnpm installs from web/pnpm-lock.yaml
/web/node_modules/

# Contact messages written at runtime
/data/

# The server's own folder, which its host key is made in and the owner's preview key kept in
/.paranin/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# The old tree, kept to read while its replacements land (docs/FOUNDATION.md §8)
/_old/

# Everything a build writes: the front end, Typst, a local release folder
/build/
