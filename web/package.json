{
  "name": "paranin-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "prettier": {
    "printWidth": 120,
    "plugins": [
      "prettier-plugin-svelte"
    ]
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "lint:styles": "stylelint \"src/**/*.{css,svelte}\" \"tests/**/*.svelte\"",
    "lint:scripts": "eslint .",
    "check:types": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:unused": "knip",
    "test": "vitest run",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.24.1",
    "jsdom": "30.1.3",
    "knip": "6.44.1",
    "postcss-html": "2.0.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.2.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
