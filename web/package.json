{
  "name": "paranin-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "prettier": {
    "printWidth": 120
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "lint:scripts": "eslint .",
    "check:types": "tsc --noEmit",
    "check:unused": "knip",
    "test": "vitest run",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "knip": "6.44.1",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
