package html

import (
	"strconv"
	"time"

	"github.com/vrppaul/paranin/internal/compose"
	"github.com/vrppaul/paranin/internal/document"
	"github.com/vrppaul/paranin/internal/look"
	"github.com/vrppaul/paranin/internal/routes"
)

// The mark before a post's tag, as readers know a tag that gathers posts (DESIGN.md, Content), and after a pick that
// opens a window (DESIGN.md, Iconography)
const (
	tagMark  = "#"
	pickMark = "▾"
)

// postMain is a post's main part (DESIGN.md, Pages): its head, its outline beside its article, then the panes at its
// foot, all on one grid, so the numbers, the words and the sources beside them stand in the same columns from the head
// to the foot; at the article's end its sources, every note once, which the stylesheet shows where the screen has no
// room for them beside the text.
templ (writer PageWriter) postMain(parts postParts) {
	<article class="post">
		@writer.postHead(parts.head)
		if len(parts.outline) > 0 {
			@writer.outline(parts.outline)
		}
		<div class="article">
			@parts.article
			if len(parts.notes) > 0 {
				<div class="sources-end">
					for _, note := range parts.notes {
						@writer.note(note)
					}
				</div>
			}
		</div>
		if parts.panes != nil {
			@writer.panes(*parts.panes)
		}
	</article>
}

// outline is a post's headings of its top level (DESIGN.md, Outline), each a link to its heading, which the site's
// script marks as the heading read while the article scrolls; without the script none is marked.
templ (writer PageWriter) outline(headings []outlined) {
	<nav class="outline" aria-label={ writer.frame.contents } data-part={ outlinePart }>
		<ol class="outline-headings">
			for _, heading := range headings {
				<li>
					<a href={ fragmentMark + heading.id } data-part={ outlineLinkPart }>
						@writer.spans(heading.title)
					</a>
				</li>
			}
		</ol>
	</nav>
}

// postHead is a post's first screen (DESIGN.md, PostHead): its title, the page's h1, and its lead, in the headline's
// style, in one column; beside them, in the sources' column, its facts: the version read, by its day, the pick of its
// versions, an older one saying under it that a newer stands, a translation older than its original that the original
// changed since, or a draft's by the site's word for one, its series'
// pick, the Switch of the languages it is read in, and its tags; the corners' crosses round it, as round the résumé's
// first screen.
templ (writer PageWriter) postHead(head document.Head) {
	<header class="post-head">
		<div class="post-intro">
			<h1 class="post-title">
				@writer.spans(head.Title)
			</h1>
			if len(head.Lead) > 0 {
				<p class="lead">
					@writer.spans(head.Lead)
				</p>
			}
		</div>
		<dl class="facts post-facts">
			switch version := head.Version.(type) {
				case document.VersionOut:
					<dt>{ writer.frame.postLabels.Version }</dt>
					<dd>
						@writer.versionPick(version.Day, version.Versions)
						if version.Outdated != nil {
							@writer.outdated(*version.Outdated)
						}
					</dd>
				case document.VersionOlder:
					<dt>{ writer.frame.postLabels.Version }</dt>
					<dd>
						@writer.versionPick(version.Day, version.Versions)
						@writer.newer(version)
					</dd>
				case document.VersionDraft:
					<dt>{ writer.frame.postLabels.Version }</dt>
					<dd>{ version.Word }</dd>
			}
			if head.Post != nil && head.Post.Series != nil {
				<dt>{ writer.frame.postLabels.Series }</dt>
				<dd>
					@writer.seriesPick(writer.headPick(*head.Post.Series))
				</dd>
			}
			if len(head.Languages) > 0 {
				<dt>{ writer.frame.postLabels.Language }</dt>
				<dd>
					@writer.languageSwitch(head.Languages)
				</dd>
			}
			if len(head.Filters) > 0 {
				<dt>{ writer.frame.postLabels.Tags }</dt>
				<dd>
					@writer.filters(head.Filters)
				</dd>
			}
		</dl>
		@corners()
	</header>
}

// languageSwitch is the Switch of the languages a post is read in (DESIGN.md, Switch): each language by its tag, a
// link to the post in it, the one read current.
templ (writer PageWriter) languageSwitch(languages []document.Language) {
	<span class="switch">
		for _, language := range languages {
			<a
				class="switch-way"
				href={ routes.Reference(language.Page, routes.FormatChosen) }
				hreflang={ language.Tag }
				if language.Read {
					aria-current={ currentPage }
				}
			>{ language.Tag }</a>
		}
	</span>
}

// day is a post's day as a time: as a reader of the page's language reads it, and as a machine does.
templ (writer PageWriter) day(published time.Time) {
	<time datetime={ published.Format(machineDayLayout) }>{ writer.frame.days.Of(published) }</time>
}

// versionPick is the versions' Pick (DESIGN.md, Pick): the day of the version read and a mark saying it opens a
// window, which it does as the browser's popover, with no script, Esc closing it; the window, titled in the site's
// word for the versions, lists each, newest first, its close button last, so the keyboard reaches the versions first.
templ (writer PageWriter) versionPick(read time.Time, versions []document.PostVersion) {
	<button type="button" class="version-pick" popovertarget={ ownID(versionsPickID) }>
		@writer.day(read)
		@text(wordSpace)
		<span class="pick-mark" aria-hidden="true">{ pickMark }</span>
	</button>
	<div id={ ownID(versionsPickID) } class="pick" popover role="dialog" aria-labelledby={ ownID(versionsPickID + pickTitleEnd) }>
		<p id={ ownID(versionsPickID + pickTitleEnd) } class="pick-title">{ writer.frame.versionWords.Title }</p>
		<ol class="pick-parts">
			for _, version := range versions {
				@writer.pickVersion(version)
			}
		</ol>
		@pickClose(ownID(versionsPickID))
	</div>
}

// pickVersion is a version of a post in its pick's window: its day and where it stands for the reader; the version read
// the current page, any other a link to it.
templ (writer PageWriter) pickVersion(version document.PostVersion) {
	<li
		class={ "pick-part", templ.KV("version-read", version.Read) }
		if version.Read {
			aria-current="page"
		}
	>
		if version.Read {
			<span class="pick-row version-row">
				@writer.versionRow(version)
			</span>
		} else {
			<a class="pick-row version-row" href={ routes.Reference(version.Page, routes.FormatChosen) }>
				@writer.versionRow(version)
			</a>
		}
	</li>
}

// versionRow is a version's row in its pick's window: its day, and where it stands, none for an older one not read.
templ (writer PageWriter) versionRow(version document.PostVersion) {
	@writer.day(version.Day)
	if state := writer.frame.versionWords.State(version); state != "" {
		@text(wordSpace)
		<span class="version-state">{ state }</span>
	}
}

// newer is what an older version of a post says under its day (DESIGN.md, PostHead), as a version's note: that a newer
// stands, the arrow, then the site's words round the current version's day, the whole a link to it.
templ (writer PageWriter) newer(older document.VersionOlder) {
	<a class="version-note" href={ routes.Reference(older.Newer.Page, routes.FormatChosen) }>
		<span class="version-note-mark" aria-hidden="true">{ look.VersionNoteMark }</span>
		{ older.NewerWords.Before }
		@writer.day(older.Newer.Day)
		{ older.NewerWords.After }
	</a>
}

// outdated is what a translation older than its original says under its day (DESIGN.md, PostHead), as a version's
// note: the arrow, then the site's words, the whole a link to the original, in the original's language.
templ (writer PageWriter) outdated(note document.Outdated) {
	<a class="version-note" href={ routes.Reference(note.Original, routes.FormatChosen) } hreflang={ note.Language }>
		<span class="version-note-mark" aria-hidden="true">{ look.VersionNoteMark }</span>
		{ note.Words }
	</a>
}

// pickClose is the button that closes a pick's window, by the window's id: Esc's cap, then the word.
templ pickClose(window string) {
	<button type="button" class="hint-close" lang={ frameLanguage } popovertarget={ window } popovertargetaction="hide"><kbd class="command-key" aria-hidden="true">{ escapeKey }</kbd> { closeHint }</button>
}

// tags are a tile's tags, words of the tile (DESIGN.md, Tag).
templ tags(tags []string) {
	<ul class="tags">
		for _, tag := range tags {
			<li>
				@tagWords(tag)
			</li>
		}
	</ul>
}

// filters are the filters a head offers, the list's or a post's (DESIGN.md, Tag and BlogHead), in the order compose
// hands them: each a link where it leads somewhere, words where it leads nowhere; the one the list shown is filtered by
// current, named as the way to the whole list.
templ (writer PageWriter) filters(filters []document.Filter) {
	<ul class="tags">
		for _, filter := range filters {
			<li>
				if address := routes.Reference(filter.Page, routes.FormatChosen); address == "" {
					@tagWords(filter.Tag)
				} else if filter.Current {
					<a class="tag" href={ address } aria-current={ currentWay } aria-label={ filter.WayOut }>
						@tagWords(filter.Tag)
					</a>
				} else {
					<a class="tag" href={ address }>
						@tagWords(filter.Tag)
					</a>
				}
			</li>
		}
	</ul>
}

// tagWords are a tag's words, its word after a hash a screen reader skips.
templ tagWords(tag string) {
	<span class="tag-mark" aria-hidden="true">{ tagMark }</span>{ tag }
}

// seriesPick is the series' Pick (DESIGN.md, Pick): the chip, its words, the count after them and a mark saying it
// opens a window, which it does as the browser's popover, with no script, Esc closing it; the window, titled by the
// series, lists every part, its close button last, so the keyboard reaches the parts first. The words stand in an
// element of their own, which the stylesheet cuts short where the chip lacks room, whole for a screen reader.
templ (writer PageWriter) seriesPick(shown pick) {
	<button type="button" class="way-chip series-pick" popovertarget={ shown.id }>
		<span class="pick-words">{ shown.words }</span>
		if shown.count != "" {
			<span class="series-count">{ shown.count }</span>
		}
		<span class="pick-mark" aria-hidden="true">{ pickMark }</span>
	</button>
	<div id={ shown.id } class="pick" popover role="dialog" aria-labelledby={ shown.titleID }>
		<p id={ shown.titleID } class="pick-title">
			@writer.spans(shown.series.Title)
		</p>
		<ol class="pick-parts">
			for _, part := range shown.series.Parts {
				@writer.pickPart(part)
			}
		</ol>
		@pickClose(shown.id)
	</div>
}

// pickPart is a part of a series in its pick's window: its number, its title and where it stands for the reader; the
// part read the current page, a part out a link to it, a part to come no link.
templ (writer PageWriter) pickPart(part document.Part) {
	<li
		class={ "pick-part", templ.KV("part-reading", part.State == document.PartReading), templ.KV("part-next", part.State == document.PartNext), templ.KV("part-to-come", part.State == document.PartToCome) }
		if part.State == document.PartReading {
			aria-current="page"
		}
	>
		if part.State == document.PartNext || part.State == document.PartOut {
			<a class="pick-row" href={ routes.Reference(part.Page, routes.FormatChosen) }>
				@writer.partRow(part)
			</a>
		} else {
			<span class="pick-row">
				@writer.partRow(part)
			</span>
		}
	</li>
}

// partRow is a part's row in its pick's window: its number, its title, and where it stands, empty for a part out.
templ (writer PageWriter) partRow(part document.Part) {
	<span class="part-number">{ strconv.Itoa(part.Number) }</span>
	<span class="part-title">
		@writer.spans(part.Title)
	</span>
	<span class="part-state">{ writer.frame.seriesWords.State(part.State) }</span>
}

// panes are the foot of a post's article (DESIGN.md, Panes): a heading saying where they lead, the series' pick beside
// it where the post is a part of one, a link to the blog's list where it is not, a page and no window; the two sides,
// the posts before and after it; and where the post is discussed.
templ (writer PageWriter) panes(foot panesFoot) {
	<footer class="panes-foot">
		<div class="panes-heading">
			<h2 id={ ownID(panesHeadingID) } class="panes-title">{ foot.heading }</h2>
			if foot.pick != nil {
				@writer.seriesPick(*foot.pick)
			}
			if foot.allPosts != "" {
				<a class="panes-all" href={ foot.allPosts }>{ writer.frame.listWords.AllPosts }</a>
			}
		</div>
		<nav class="panes" aria-labelledby={ ownID(panesHeadingID) }>
			@writer.pane(foot.before)
			@writer.pane(foot.after)
		</nav>
		if len(foot.discussions) > 0 {
			<p class="discussions">
				<span class="discuss">{ writer.frame.paneWords.Discuss }</span>
				@text(wordSpace)
				@writer.linkLine(foot.discussions)
			</p>
		}
	</footer>
}

// pane is a side of a post's foot, as tmux splits a window: its name set into its top edge, then the post there, the
// whole pane a link to it, its title, its lead and, outside a series, the day it came out; a part to come by its title
// and the word saying it comes, no link; a side with nothing there saying so.
templ (writer PageWriter) pane(side paneSide) {
	if side.neighbour == nil {
		<div class={ "pane", "pane-none", templ.KV("pane-after", side.after) }>
			<span class="edge"><span class="edge-name">{ side.name }</span></span>
			<span class="pane-words">{ side.none }</span>
		</div>
	} else if side.neighbour.Page.Kind == document.PageNone {
		<div class={ "pane", templ.KV("pane-after", side.after) }>
			<span class="edge"><span class="edge-name">{ side.name }</span></span>
			<span class="pane-title pane-to-come">
				@writer.spans(side.neighbour.Title)
				@text(wordSpace)
				<span class="pane-soon">{ writer.frame.seriesWords.State(document.PartToCome) }</span>
			</span>
		</div>
	} else {
		<a class={ "pane", templ.KV("pane-after", side.after) } href={ routes.Reference(side.neighbour.Page, routes.FormatChosen) }>
			<span class="edge"><span class="edge-name">{ side.name }</span></span>
			<span class="pane-title">
				@writer.spans(side.neighbour.Title)
			</span>
			<span class="pane-lead">
				@writer.spans(side.neighbour.Lead)
			</span>
			if !side.neighbour.Published.IsZero() {
				<span class="pane-date">
					@writer.day(side.neighbour.Published)
				</span>
			}
		</a>
	}
}

// articleSection is a section of a post's article: its heading at its depth, named and found as the article names it,
// then its parts, which stand on the article's grid as if the section held none.
templ (writer PageWriter) articleSection(named templ.Attributes, depth int, title []document.Span, parts []templ.Component) {
	<section class="article-section">
		@headingWith(depth, named, writer.spans(title))
		for _, part := range parts {
			@part
		}
	</section>
}

// numberedParagraph is a paragraph of a post's article (DESIGN.md, Article): its number in the margin, a link to it,
// then its words, named for the link.
templ (writer PageWriter) numberedParagraph(number, id string, spans []document.Span) {
	<a class="paragraph-number" href={ fragmentMark + id }>{ number }</a>
	<p id={ id }>
		@writer.spans(spans)
	</p>
}

// notesBeside are the notes a block is the first to cite, beside it, each under its number; the stylesheet shows them
// where the screen has room for them beside the text, and the sources at the article's end where it has not.
templ (writer PageWriter) notesBeside(notes []document.Note) {
	<aside class="notes">
		for _, note := range notes {
			@writer.note(note)
		}
	</aside>
}

// note is a note's number, then its words.
templ (writer PageWriter) note(note document.Note) {
	<p class="note">
		<span class="note-number">{ strconv.Itoa(note.Number) }</span>
		@text(wordSpace)
		@writer.spans(note.Spans)
	</p>
}

// citation is a note's number where a line cites it, raised, as the note beside the line is numbered.
templ citation(number int) {
	<sup class="citation">{ strconv.Itoa(number) }</sup>
}

// postList is a post's list (DESIGN.md, Article), its items drawn: each after its mark hanging in the margin, a dash
// as the résumé's points, which a screen reader skips, or its number from its start, which it reads, since its own
// count of the items starts at one; a list still to a screen reader, though it draws no marker of its own.
templ postList(ordered bool, start int, items []listedItem) {
	if ordered {
		<ol class="post-list points" role="list" start={ strconv.Itoa(start) }>
			@listedItems(items, ordered)
		</ol>
	} else {
		<ul class="post-list points" role="list">
			@listedItems(items, ordered)
		</ul>
	}
}

// listedItems are a post's list's items, each its mark, a number read or a dash hidden from a screen reader, then what
// it holds, a block it opens with on the mark's line.
templ listedItems(items []listedItem, ordered bool) {
	for _, item := range items {
		<li class={ "post-item", templ.KV("post-item-block", item.opensBlock) }>
			if ordered {
				<span class="point-mark">{ item.mark }</span>
			} else {
				<span class="point-mark" aria-hidden="true">{ item.mark }</span>
			}
			@text(pointSpace)
			@item.content
		</li>
	}
}

// postQuote is words a post quotes (DESIGN.md, Article), its blocks drawn, behind a bar.
templ postQuote(blocks []templ.Component) {
	<blockquote>
		for _, block := range blocks {
			@block
		}
	</blockquote>
}

// pause is a turn a post takes inside a part (DESIGN.md, Article): a rule, which a screen reader names a separator,
// carrying the stars the stylesheet draws it as, since a rule holds no text.
templ pause() {
	<hr data-mark={ look.PauseMark }/>
}

// figure is a picture of a post (DESIGN.md, Article): the picture by its size, which the stylesheet narrows to the
// text's column in its own shape, so its room is kept before it comes, fetched as it nears the screen; its caption
// under it, where it has one.
templ (writer PageWriter) figure(shown document.Figure) {
	<figure>
		<img src={ routes.Reference(shown.Picture, routes.FormatChosen) } alt={ shown.Alt } width={ strconv.Itoa(shown.Width) } height={ strconv.Itoa(shown.Height) } loading="lazy" decoding="async"/>
		if shown.Caption != "" {
			<figcaption>{ shown.Caption }</figcaption>
		}
	</figure>
}

// widget is a post's widget (DESIGN.md, Article), named by its anchor for a link to reach it, an island of the
// component it names: a window, its name set into its top edge and, at its right, the mark that it runs, hidden until
// the site's script runs it; inside, its body, where the component runs, holding its alt text, which stands for it
// until then and describes it to a screen reader after, by an id of the page's own; and its props, a block of JSON
// the script hands the component, which templ writes with HTML's marks escaped, so no text of theirs closes the block;
// its caption under the window, where it has one.
templ (writer PageWriter) widget(shown document.Widget) {
	<figure id={ shown.Live.Name } class="widget" data-island={ shown.Name }>
		<div class="widget-window">
			<span class="edge">
				<span class="edge-name">
					for index, word := range nameWords(shown.Name) {
						if index > 0 {
							<wbr/>{ word }
						} else {
							{ word }
						}
					}
				</span>
				<span class="widget-live" data-part={ widgetLivePart } hidden>
					<span class="widget-live-mark" aria-hidden="true">{ look.LiveMark }</span>
					{ writer.frame.liveWord }
				</span>
			</span>
			<div class="widget-body" data-part={ widgetBodyPart }>
				<p id={ ownID(shown.Live.Name + widgetAltEnd) } class="widget-alt" data-part={ widgetAltPart }>{ shown.Alt }</p>
			</div>
			@templ.JSONScript("", shown.Props)
		</div>
		if shown.Caption != "" {
			<figcaption>{ shown.Caption }</figcaption>
		}
	</figure>
}

// copyableCode is a post's code on lines of its own (DESIGN.md, Article and Code): first its bar, which the stylesheet
// sets at its top right, the language it is written in, where its author names one, and the button that copies it,
// hidden until the site's script shows it; then the code as it is, line for line, scrolling sideways rather than
// wrapping. The toast says what was copied.
templ copyableCode(code document.CodeBlock, button compose.CopyButton) {
	<div class="code" data-part={ codePart }>
		<p class="code-bar">
			if code.Language != "" {
				<span class="code-language">{ code.Language }</span>
			}
			<button type="button" class="code-copy" data-part={ copyPart } aria-label={ button.CopyName } data-copied={ button.Copied } data-toast={ button.Toast } hidden>{ button.Copy }</button>
		</p>
		<pre class="code-block">
			<code data-part={ codeWordsPart }>
				@codeRuns(code.Runs)
			</code>
		</pre>
	</div>
}
