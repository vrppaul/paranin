package html

// page is the page of a path the site has no page at, quoted, in the frame of every page (DESIGN.md, Pages): its
// status in block letters, the path, and a link to where the site begins; no apology and no joke. They stand in a part
// of their own inside the main part, which is the frame's on every page, as the résumé's first screen does.
templ (notFound NotFound) page(quotedPath string) {
	<!DOCTYPE html>
	<html lang={ notFound.language }>
		<head>
			@headOpening(notFound.status, notFound.included)
		</head>
		<body>
			<main class="content-width">
				<div class="not-found">
					@notFound.heading
					<p><code>{ quotedPath }</code></p>
					<p><a href={ notFound.foot.frame.start }>{ notFound.foot.frame.siteName }</a></p>
				</div>
			</main>
			@footLineMarkup(notFound.foot)
		</body>
	</html>
}
