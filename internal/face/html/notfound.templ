package html

// page is the page of a path the site has no page at, quoted, in the frame of every page: its status, the path, and
// a link to where the site begins.
templ (notFound NotFound) page(quotedPath string) {
	<!DOCTYPE html>
	<html lang={ notFound.language }>
		<head>
			@headOpening(notFound.status, notFound.included)
		</head>
		<body>
			@topBar(notFound.frame)
			<main id={ mainID }>
				<h1>{ notFound.status }</h1>
				<p><code>{ quotedPath }</code></p>
				<p><a href={ notFound.frame.start }>{ notFound.frame.siteName }</a></p>
			</main>
		</body>
	</html>
}
