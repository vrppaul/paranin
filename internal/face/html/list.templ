package html

import (
	"github.com/vrppaul/paranin/internal/document"
	"github.com/vrppaul/paranin/internal/routes"
)

// listMain is the blog's list's main part (DESIGN.md, Pages and Layout): its head, then its groups, all on one grid of
// two columns, the groups' names and the tiles, each group taking both as its own, so its name stays in sight only
// while its own tiles scroll.
templ (writer PageWriter) listMain(head document.Head, groupings []grouping, blocks []document.Block) {
	<div class="blog">
		@writer.blogHead(head, groupings)
		for _, block := range blocks {
			@writer.listBlock(block)
		}
	</div>
}

// blogHead is the list's head (DESIGN.md, BlogHead): the blog's name in the titles' block letters, the page's h1, in
// the names' column; beside it the blog's line, then the word before the Switch of the list's groupings, each a link
// to the list grouped so, the one shown current, and its filters, the tags of the posts it lists among them, each
// leading to the list it filters, the filter shown reversed.
templ (writer PageWriter) blogHead(head document.Head, groupings []grouping) {
	<header class="blog-head">
		@titleHeading(document.PlainText(head.Title), writer.spans(head.Title))
		<div class="blog-about">
			<p class="lead">
				@writer.spans(head.Lead)
			</p>
			<div class="blog-ways">
				<span class="blog-by">{ writer.frame.listWords.By }</span>
				<span class="switch">
					for _, shown := range groupings {
						<a
							class="switch-way"
							href={ shown.address }
							if shown.current != "" {
								aria-current={ shown.current }
							}
						>{ shown.words }</a>
					}
				</span>
				if len(head.Filters) > 0 {
					@writer.filters(head.Filters)
				}
			</div>
		</div>
	</header>
}

// postGroup is a group of the list (DESIGN.md, Group): its name, a series' line under it and how many posts it holds,
// then its posts as tiles; a series' group at its anchor, which the series' place leads to.
templ (writer PageWriter) postGroup(group document.Group) {
	<section
		if group.Name != "" {
			id={ group.Name }
		}
		class="group"
	>
		<div class="group-name">
			<h2 class="group-title">
				@writer.spans(group.Title)
			</h2>
			if len(group.Posts.Line) > 0 {
				<p class="group-line">
					@writer.spans(group.Posts.Line)
				</p>
			}
			<p class="group-count">
				@writer.spans(group.Posts.Count)
			</p>
		</div>
		@writer.tiles(group.Posts)
	</section>
}

// tiles are the posts a group names, each as its tile.
templ (writer PageWriter) tiles(posts document.Posts) {
	<ol class="tiles">
		for _, post := range posts.List {
			<li>
				@writer.tile(post)
			</li>
		}
	</ol>
}

// tileOut is a post out as its tile (DESIGN.md, Tile), a pane, its day set into its top edge, the whole of it leading
// to the post by its title's link, which the stylesheet stretches over the tile, since its series leads elsewhere and
// a link holds no other.
templ (writer PageWriter) tileOut(post document.ListedPost, out document.PostOut) {
	<div class="pane tile">
		@writer.tileParts(post, writer.day(out.Published), routes.Reference(out.Page, routes.FormatChosen))
	</div>
}

// tileToCome is a part of a series still to come as its tile, off, with no link, the word saying it comes set into its
// top edge.
templ (writer PageWriter) tileToCome(post document.ListedPost, toCome document.ComingPart) {
	<div class="pane tile tile-to-come">
		@writer.tileParts(post, writer.spans(toCome.Coming), "")
	</div>
}

// tileParts are what a tile holds: its edge and its title, a link to its post where it has an address, the edge
// inside it, so the link's name opens with the day and the edge leads to the post too; its lead; and at its foot where
// it stands, its part and its series' title, a link to the series' group on the list by series, where its group is no
// series' own, and its tags, words of the tile.
templ (writer PageWriter) tileParts(post document.ListedPost, when templ.Component, address string) {
	if address != "" {
		<a class="tile-title" href={ address }>
			@writer.tileEdge(post, when)
			@text(wordSpace)
			@writer.spans(post.Title)
		</a>
	} else {
		@writer.tileEdge(post, when)
		<span class="tile-title">
			@writer.spans(post.Title)
		</span>
	}
	if len(post.Lead) > 0 {
		<span class="tile-lead">
			@writer.spans(post.Lead)
		</span>
	}
	if len(post.Series) > 0 || len(post.Tags) > 0 {
		<div class="tile-foot">
			if len(post.Series) > 0 {
				<span class="tile-series">
					<span class="tile-part">{ document.PlainText(post.Part) }</span><span class="tile-dot">{ dot }</span>
					<a class="tile-series-link" href={ routes.Reference(post.SeriesGroup, routes.FormatChosen) }>
						@writer.spans(post.Series)
					</a>
				</span>
			}
			if len(post.Tags) > 0 {
				@tags(post.Tags)
			}
		</div>
	}
}

// tileEdge is what is set into a tile's top edge, as a pane's name: when its post came out or that it comes, after its
// part in its series' own group.
templ (writer PageWriter) tileEdge(post document.ListedPost, when templ.Component) {
	<span class="edge">
		<span class="edge-name tile-edge">
			if post.InItsSeriesGroup() {
				<span class="tile-part">
					@writer.spans(post.Part)
				</span>
				@text(dot)
			}
			@when
		</span>
	</span>
}
